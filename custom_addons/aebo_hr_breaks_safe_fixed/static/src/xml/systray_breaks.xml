
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="aebo_hr_breaks_safe.SystrayBreaks" owl="1">
    <div class="dropdown aebo-breaks-systray">
      <a role="button" class="dropdown-toggle o-no-caret o_systray_icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Breaks">
        <i class="fa fa-coffee"/>
        <span t-if="state.breakOn" class="aebo-dot aebo-dot--on"/>
        <span t-if="!state.breakOn" class="aebo-dot aebo-dot--off"/>
      </a>
      <div class="dropdown-menu dropdown-menu-end">
        <div class="p-3 text-center">
          <div class="mb-2 small" t-if="!state.checkedIn">You are not checked in.</div>
          <button class="btn btn-secondary me-2"
                  t-att-disabled="!state.checkedIn || state.breakOn"
                  t-on-click="breakIn">Break In</button>
          <button class="btn btn-outline-secondary"
                  t-att-disabled="!state.checkedIn || !state.breakOn"
                  t-on-click="breakOut">Break Out</button>
        </div>
      </div>
    </div>
  </t>
</templates>
