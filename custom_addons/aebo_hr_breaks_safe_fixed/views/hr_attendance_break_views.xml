
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_attendance_tree_inherit_breaks" model="ir.ui.view">
    <field name="name">hr.attendance.list.inherit.breaks</field>
    <field name="model">hr.attendance</field>
    <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='worked_hours']" position="after">
        <field name="break_hours" string="Break Hours" widget="float_time" optional="show"/>
      </xpath>
    </field>
  </record>

  <record id="hr_attendance_view_form_inherit_breaks" model="ir.ui.view">
    <field name="name">hr.attendance.form.inherit.breaks</field>
    <field name="model">hr.attendance</field>
    <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/group" position="after">
        <notebook>
          <page string="Breaks">
            <group>
              <field name="break_hours" widget="float_time" readonly="1"/>
            </group>
            <field name="break_ids" context="{'default_attendance_id': active_id}">
              <tree editable="bottom">
                <field name="break_in"/>
                <field name="break_out"/>
                <field name="duration" widget="float_time" readonly="1"/>
              </tree>
              <form>
                <group>
                  <field name="break_in"/>
                  <field name="break_out"/>
                  <field name="duration" widget="float_time" readonly="1"/>
                </group>
              </form>
            </field>
          </page>
        </notebook>
      </xpath>
    </field>
  </record>
</odoo>
