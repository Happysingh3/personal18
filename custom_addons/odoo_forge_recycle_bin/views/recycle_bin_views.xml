<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action to Open Recycle Bin Tree View -->
    <record id="action_recycle_bin" model="ir.actions.act_window">
        <field name="name">Recycle Bin</field>
        <field name="res_model">recycle.bin</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No records found in Recycle Bin.
            </p>
        </field>
    </record>


    <!-- Tree View for Recycle Bin -->
    <record id="view_recycle_bin_tree" model="ir.ui.view">
            <field name="name">recycle.bin.tree</field>
            <field name="model">recycle.bin</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="model_id"/>
                    <field name="record_id"/>
                    <field name="parent_record_id"/>
                    <field name="deleted_datetime"/>
                    <field name="user_id"/>
                    <field name="parent_id"/>
                    <field name="child_ids"/>
                    <field name="deleted_data"/>
                    <button name="restore_record" string="Restore Record" type="object" class="oe_highlight"/>
                </list>
            </field>
        </record>
    
    <record id="view_recycle_bin_form" model="ir.ui.view">
        <field name="name">recycle.bin.form</field>
        <field name="model">recycle.bin</field>
        <field name="arch" type="xml">
            <form string="Recycle Bin">
                <header>
                    <button name="restore_record" string="Restore Record" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" string="Name of Record"/>
                        <field name="model_id" options="{'no_create': True}" string="Model"/>
                        <field name="record_id" string="Deleted Record ID"/>
                        <field name="parent_record_id"/>
                        <field name="deleted_datetime" string="Record Deleted At"/>
                        <field name="user_id" options="{'no_create': True}" string="Deleted By"/>
                        <field name="parent_id"/>
                        <field name="child_ids"/>
                        <field name="deleted_data" widget="text" string="Record Data (JSON)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Menu Items for Recycle Bin -->
    <menuitem id="menu_recycle_bin_root" name="Recycle Bin"
        sequence="10"/>

    <menuitem id="menu_recycle_bin" name="Recycle Bin"
        parent="menu_recycle_bin_root"
        action="action_recycle_bin"
        sequence="10"/>
    

</odoo>
