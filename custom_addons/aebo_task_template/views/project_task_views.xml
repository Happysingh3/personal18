<odoo>
  <!-- Task Form: add Template Task after Assignees -->
  <record id="view_task_form_inherit_template_task" model="ir.ui.view">
    <field name="name">project.task.form.inherit.template.task</field>
    <field name="model">project.task</field>
    <!-- Odoo 18: main task form external id -->
    <field name="inherit_id" ref="project.view_task_form2"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='user_ids']" position="after">
        <field name="template_task_id" options="{'no_create': True}"/>
      </xpath>
    </field>
  </record>

  <!-- Quick-create popup: add Template Task after Assignees -->
  <record id="view_task_quick_create_inherit_template_task" model="ir.ui.view">
    <field name="name">project.task.quick.create.inherit.template.task</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.quick_create_task_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='user_ids']" position="after">
            <field name="template_task_id" placeholder="Pick template task" options="{'no_create': True}"/>
        </xpath>
    </field>
</record>
</odoo>