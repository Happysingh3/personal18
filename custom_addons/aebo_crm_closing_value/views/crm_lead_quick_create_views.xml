<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_crm_lead_quick_create_inherit_aebo_extra" model="ir.ui.view">
    <field name="name">crm.lead.quick.create.inherit.aebo.extra</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='phone']" position="after">

        <field name="dropdown_field" string="Dropdown Menu"/>

        <field name="product_id"
               string="Product"
               domain="[('sale_ok','=',True)]"
               options="{'no_create_edit': True}"
               invisible="dropdown_field != 'product'"
               required="dropdown_field == 'product'"/>

        <field name="drone_details"
               placeholder="Enter drone details"
               invisible="dropdown_field != 'custom'"
               required="dropdown_field == 'custom'"/>

        <field name="stage_closing_date" string="Stage Closing Date"/>

        <!-- show only for Tender teams -->
        <field name="tender_closing_date"
               string="Tender Closing Date"
               invisible="not is_tender_team"/>

        <field name="assignee_ids"
               string="Assignees"
               widget="many2many_tags"
               domain="[('share','=',False), ('active','=',True)]"
               options="{'no_create': True, 'no_create_edit': True}"/>
      </xpath>
    </field>
  </record>
</odoo>