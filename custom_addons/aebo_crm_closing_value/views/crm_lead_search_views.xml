<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- LEADS (type = lead) : add a new filter that also includes assignee_ids -->
  <record id="aebo_view_crm_leads_filter_inherit" model="ir.ui.view">
    <field name="name">aebo.crm.lead.search.my_leads.assignees</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
    <field name="arch" type="xml">
      <!-- safer: insert into <search>, not targeting a specific filter by name -->
      <xpath expr="//search" position="inside">
        <separator/>
        <filter name="my_leads_assignees"
                string="My Leads (owner or assignee)"
                domain="['|','|',
                          ('user_id', '=', uid),
                          ('team_id.member_ids', 'in', [uid]),
                          ('assignee_ids', 'in', [uid])
                        ]"/>
      </xpath>
    </field>
  </record>

  <!-- OPPORTUNITIES (type = opportunity) : add similar filter -->
  <record id="aebo_view_crm_oppor_filter_inherit" model="ir.ui.view">
    <field name="name">aebo.crm.oppor.search.my_pipeline.assignees</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <separator/>
        <filter name="my_pipelines_assignees"
                string="My Pipeline (owner or assignee)"
                domain="['|','|',
                          ('user_id', '=', uid),
                          ('team_id.member_ids', 'in', [uid]),
                          ('assignee_ids', 'in', [uid])
                        ]"/>
      </xpath>
    </field>
  </record>

</odoo>