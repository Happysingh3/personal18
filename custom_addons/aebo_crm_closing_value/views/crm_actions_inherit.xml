<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Leads menu action -->
  <record id="crm.crm_lead_all_leads" model="ir.actions.act_window">
    <field name="context" eval="{
        'search_default_my_leads_assignees': 1,
        'default_type': 'lead'
    }"/>
  </record>

  <!-- Opportunities menu action -->
  <record id="crm.crm_lead_opportunities" model="ir.actions.act_window">
    <field name="context" eval="{
        'search_default_my_pipelines_assignees': 1,
        'default_type': 'opportunity'
    }"/>
  </record>
</odoo>