<odoo>
  <record id="ir_cron_crm_deadline_activity" model="ir.cron">
    <field name="name">CRM: Ensure Expected Closing Activities</field>
    <field name="model_id" ref="base.model_crm_lead"/>
    <field name="state">code</field>
    <field name="code">
model.search([('date_deadline','!=',False), ('active','=',True)])._ensure_deadline_activity()
    </field>
    <field name="interval_type">days</field>
    <field name="interval_number">1</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
  </record>
</odoo>