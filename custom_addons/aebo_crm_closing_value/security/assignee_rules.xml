<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- CRM: assignees can see/edit the lead -->
  <record id="rule_crm_lead_assignee_access" model="ir.rule">
    <field name="name">CRM: Assignees can access</field>
    <field name="model_id" ref="crm.model_crm_lead"/>
    <!-- normal internal users -->
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <!-- domain: current user is main salesperson OR in team OR in assignees -->
    <field name="domain_force">
      ['|','|',
        ('user_id', '=', user.id),
        ('team_id.member_ids', 'in', [user.id]),
        ('assignee_ids', 'in', [user.id])
      ]
    </field>
    <field name="perm_read" eval="1"/>
    <field name="perm_write" eval="1"/>
    <field name="perm_create" eval="1"/>
    <field name="perm_unlink" eval="0"/>
  </record>
</odoo>