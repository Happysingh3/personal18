<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_aebo_birthday_discuss_settings_form" model="ir.ui.view">
    <field name="name">aebo.birthday.discuss.settings.form</field>
    <field name="model">aebo.birthday.discuss.settings</field>
    <field name="arch" type="xml">
      <form string="Birthday Discuss Settings">
        <group>
          <field name="discuss_channel_id" options="{'no_open': True}"/>
        </group>
        <footer>
          <button string="Save" type="object" name="action_save" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_aebo_birthday_discuss_settings" model="ir.actions.act_window">
    <field name="name">Birthday Discuss Settings</field>
    <field name="res_model">aebo.birthday.discuss.settings</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_aebo_birthday_knk_root" name="Birthday Wishes"
            parent="mail.mail_menu_root" sequence="61"/>
  <menuitem id="menu_aebo_birthday_knk_settings" name="Settings"
            parent="menu_aebo_birthday_knk_root"
            action="action_aebo_birthday_discuss_settings" sequence="1"/>
</odoo>
