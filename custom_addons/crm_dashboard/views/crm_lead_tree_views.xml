<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Opportunities list -->
  <record id="crm_dashboard_oppor_add_closing_value" model="ir.ui.view">
    <field name="name">crm_dashboard.oppor.add.closing.value</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
    <field name="priority" eval="500"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="inside">
        <field name="closing_value_num"
               string="Expected Closing"
               widget="monetary"
               options="{'currency_field': 'company_currency'}"
               sum="Total Closing Value"/>
        <field name="closing_value_so_received"
               string="SO Received"
               widget="monetary"
               options="{'currency_field': 'company_currency'}"
               optional="hide"
               sum="SO Received Total"/>
        <!-- renamed caption -->
        <field name="closing_value_payment_to_be_received"
               string="Delivery Done"
               widget="monetary"
               options="{'currency_field': 'company_currency'}"
               optional="hide"
               sum="Delivery Done Total"/>
        <field name="closing_value_payment_received"
               string="Payment Received"
               widget="monetary"
               options="{'currency_field': 'company_currency'}"
               optional="hide"
               sum="Payment Received Total"/>
      </xpath>
    </field>
  </record>

  <!-- Leads list -->
  <record id="crm_dashboard_leads_add_closing_value" model="ir.ui.view">
    <field name="name">crm_dashboard.leads.add.closing.value</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
    <field name="priority" eval="500"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="inside">
        <field name="closing_value_num"
               string="Expected Closing"
               widget="monetary"
               options="{'currency_field': 'company_currency'}"
               sum="Total Closing Value"/>
        <field name="closing_value_so_received"
               string="SO Received"
               widget="monetary"
               options="{'currency_field': 'company_currency'}"
               optional="hide"
               sum="SO Received Total"/>
        <!-- renamed caption -->
        <field name="closing_value_payment_to_be_received"
               string="Delivery Done"
               widget="monetary"
               options="{'currency_field': 'company_currency'}"
               optional="hide"
               sum="Delivery Done Total"/>
        <field name="closing_value_payment_received"
               string="Payment Received"
               widget="monetary"
               options="{'currency_field': 'company_currency'}"
               optional="hide"
               sum="Payment Received Total"/>
      </xpath>
    </field>
  </record>

</odoo>
