<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- View for stock picking-->

    <record id="view_employee_tree" model="ir.ui.view">
        <field name="name">hr.employee.list</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="vitouhr_date_joint" optional="show"/>
<!--                <field name="vitouhr_date_expired" optional="show"/>-->
                <field name="vitouhr_telephone" optional="show"/>


            </xpath>
        </field>
    </record>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

             <xpath expr="//header/button" position="after">
                  <button name="print_badge_portrait" icon="fa-print" string="Print"
                        type="object" class="btn-primary m-1 rounded btn-sm"/>
<!--                  <button name="print_badge_portrait_cr100" icon="fa-print" string="Size CR100"-->
<!--                        type="object" class="btn-primary m-1 rounded btn-sm"/>-->

            </xpath>
            <xpath expr="//field[@name='coach_id']" position="after">
                 <field name="vitouhr_date_joint"/>
                <field name="vitouhr_telephone"/>

            </xpath>
        </field>
    </record>



    <record id="hr_kanban_view_employees" model="ir.ui.view">
        <field name="name">hr.employee.kanban</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <button name="print_badge_portrait" icon="fa-print" string="Print"
                        type="object" class="btn-primary m-1 rounded btn-sm"/>

            </xpath>
<!--            <xpath expr="//field[@name='user_id']" position="before">-->
<!--                <button name="print_badge_portrait" icon="fa-print" string="Landscape"-->
<!--                        type="object" class="btn-primary m-1 rounded"/>-->
<!--            </xpath>-->

        </field>
    </record>
</odoo>
