<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vitouhr_hr_employee_print_badge_cr80" model="ir.actions.report">
        <field name="name">Print Badge Portrait CR80</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vitou_employee_badge_free.vitouhr_print_employee_badge_cr80</field>
        <field name="report_file">vitou_employee_badge_free.vitouhr_print_employee_badge_cr80</field>
         <field name="paperformat_id" ref="vitou_employee_badge_free.paperformat_hr_employee_badge_vitou_free"/>
        <field name="print_report_name">'Badge - %s' % (object.name).replace('/', '')</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
    </record>


    <template id="vitouhr_print_employee_badge_cr80">
        <t>

            <!--            <t t-call="web.basic_layout">-->
            <t t-foreach="docs" t-as="data">
                <t t-foreach="data" t-as="employee">
                    <t t-call="web.basic_layout">
                        <div class="page m-0 p-0 w-100 h-100 "
                             t-attf-style="margin-left: 0; margin-right: 0; page-break-after: always;">
                            <!--                <div class="p-0 m-0"></div>-->

                            <div style="margin-left: 0; margin-right: 0;">
                                <t>

                                    <t>
                                        <t t-set="border_px" t-value="employee.company_id.vitouhr_border_round"/>
                                        <!--                         <t t-esc="employee.vitouhr_card_border"/>-->
                                        <div t-attf-style="display: inline-block; page-break-inside: avoid; width: 204px; height: 325px; border-radius: #{border_px}px; margin:0pt; padding: 0pt; border: 1px solid #{employee.company_id.vitouhr_font_color if employee.company_id.vitouhr_card_border else 'white'}; position: absolute; left:0; top:0;">

                                            <div class="col text-center p-0 m-0"
                                                 t-attf-style="border-radius: #{border_px}px #{border_px}px 0px 0px;">


                                                <div style="height:20px;"></div>

                                                <div class="m-0"
                                                     t-attf-style="z-index: 2;  position: absolute; left: 0; right:0; margin: 0 auto;">


                                                    <t t-if="employee.company_id.logo">
                                                        <img t-att-src="image_data_uri(employee.company_id.logo)"
                                                             t-attf-style="max-height: 35pt; max-width: 35pt; z-index: 2;  position: absolute; left: 0; right:0; margin: 0 auto;"
                                                             alt="Company Logo"/>

                                                    </t>


                                                </div>

                                                <div style="height:43px;"></div>

                                                <div class="m-0 "
                                                     t-attf-style="z-index: 2;  position: absolute; left: 0; right:0; margin: 0 auto;">


                                                    <p class="text-center"
                                                       t-attf-style="color: #{'#00446e' if employee.company_id.vitouhr_font_color_company=='' else employee.company_id.vitouhr_font_color_company}; font-size: 11px; font-weight:bold; font-size-adjust: 0.5; position: absolute; z-index: 2;  left: 0; right:0; margin: 0 auto;"
                                                       t-esc="employee.company_id.name.upper()"/>

                                                </div>


                                            </div>


                                            <div style="height:25px;"></div>
                                            <div class="row mt-2">
                                                <div class="col text-center">

                                                    <t t-if="employee.avatar_1920">
                                                        <img t-att-src="image_data_uri(employee.avatar_1920)"
                                                             t-attf-style="max-height: 50pt; max-width: 50pt; border-radius: 4px 4px 4px 4px; border: 1px solid #{'#00446e' if employee.company_id.vitouhr_font_color=='' else employee.company_id.vitouhr_font_color}; object-fit: cover; padding:10px;"
                                                             alt="Employee Image"/>
                                                    </t>

                                                </div>

                                            </div>


                                            <div class="text-center mt-1"
                                                 t-attf-style="color: #{'#00446e' if employee.company_id.vitouhr_font_color=='' else employee.company_id.vitouhr_font_color}; font-size: 12px; font-weight:bold; font-size-adjust: 0.5; margin-bottom:0px;"
                                                 t-esc="employee.name.upper()"/>

                                            <div class="text-center"
                                                 t-attf-style="font-size: 10px; color:#{'#00446e' if employee.company_id.vitouhr_font_color=='' else employee.company_id.vitouhr_font_color}; margin-top:-3px;"
                                                 t-esc="employee.department_id.name"></div>

                                            <div class="mt-0 mb-0 p-0 text-center"
                                                 t-attf-style="border-top:1px solid #{'#00446e' if employee.company_id.vitouhr_font_color=='' else employee.company_id.vitouhr_font_color}; width:60%; margin: 0 auto;"/>




<!--                                            info-->

                                            <div class="row text-center mt-0 mb-0" style="height:10px;">
                                                <div class="col-5 text-end mt-0">
                                                    <span class="text-end mt-0"
                                                          t-attf-style="font-size:9px; font-weight:bold;color:#{'#00446e' if employee.company_id.vitouhr_font_color=='' else employee.company_id.vitouhr_font_color};">
                                                        Id No :
                                                    </span>
                                                </div>
                                                <div class="col-7 text-start ms-2">
                                                    <span class="text-start" style="font-size: 9px;"
                                                          t-esc="employee.id"></span>
                                                </div>


                                            </div>


                                            <div class="row text-center mt-0 mb-0" style="height:10px;">
                                                <div class="col-5 text-end">
                                                    <span t-attf-style="font-size:9px; font-weight:bold; color:#{'#00446e' if employee.company_id.vitouhr_font_color=='' else employee.company_id.vitouhr_font_color}; ">
                                                        Jo Dt :
                                                    </span>
                                                </div>

                                                <div class="col-7 text-start ms-2">
                                                    <span class="text-center m-0" style="font-size: 9px; "
                                                          t-esc="employee.vitouhr_date_joint"></span>
                                                </div>

                                            </div>

                                            <div class="row text-center mt-0 mb-0" style="height:10px;">
                                                <div class="col-5 text-end">
                                                    <span class="m-0"
                                                          t-attf-style="font-size:9px; font-weight:bold; color:#{'#00446e' if employee.company_id.vitouhr_font_color=='' else employee.company_id.vitouhr_font_color}; ">
                                                        Ex Dt :
                                                    </span>
                                                </div>

                                                <div class="col-7 text-start ms-2">
                                                    <span class="text-center m-0" style="font-size: 9px; "
                                                          t-esc="employee.company_id.vitouhr_date_expired"></span>

                                                </div>

                                            </div>

                                             <t t-if="employee.vitouhr_telephone">
                                                <div class="row text-center mt-0 mb-0" style="height:10px;">
                                                    <div class="col-5 text-end">
                                                        <span class="m-0"
                                                              t-attf-style="font-size:9px; font-weight:bold; color:#{'#00446e' if employee.company_id.vitouhr_font_color=='' else employee.company_id.vitouhr_font_color}; ">
                                                            Tel :
                                                        </span>
                                                    </div>

                                                    <div class="col-7 text-start ms-2">
                                                        <span class="text-center m-0" style="font-size: 9px; "
                                                              t-esc="employee.vitouhr_telephone"></span>

                                                    </div>

                                                </div>
                                            </t>

<!--                                            barcode-->
                                            <t t-if="employee.company_id.vitouhr_is_qrcode">

                                                <!--                                                <span t-field="doc.name"-->
                                                <!--                                                      t-options="{'widget':'barcode', 'humanreadable':1,'width':400, 'height':100}"/>-->
                                                <div class="text-center mt-3 bg-white"
                                                     t-attf-style="z-index: 2; width:56px; height:45px; position: absolute; left: 0; right:0; margin: 0 auto; border-radius: 2px;">
                                                    <img
                                                            t-attf-style="z-index: 2;" t-if="employee.barcode"
                                                            t-att-src="'/report/barcode/QR/'+ employee.barcode"
                                                            height="40px" width="40px" alter="QR code"

                                                    />
                                                </div>


                                            </t>
                                            <t t-else="">
                                                <div t-attf-class="mt-3 text-center"
                                                     t-attf-style="z-index: 2; position: absolute; left: 0; right:0; margin: 0 auto; border-radius:2px; width:180px; max-width:80%; "
                                                     t-if="employee.barcode"
                                                     t-field="employee.barcode"
                                                     t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'max-width:80%;  height: 40px; padding:2px;', 'img_align': 'center',}"
                                                     data-oe-demo="12345678901"></div>

                                            </t>



                                            <div style="height:15px;"></div>


                                        </div>

                                    </t>


                                </t>
                            </div>


                            <!--                <div class="oe_structure"></div>-->
                        </div>
                    </t>

                </t>

            </t>

        </t>
    </template>
</odoo>
