<odoo>
  <record id="view_partner_form_inherit" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.unit</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='unit_location']" position="after">
        <field name="tender_id" placeholder="Enter Tender ID"/>
      </xpath>
    <xpath expr="//field[@name='tender_id']" position="after">
        <field name="lead_source" placeholder="Enter Lead Source"/>
      </xpath>
      <xpath expr="//field[@name='lead_source']" position="after">
        <field name="prebid_date" placeholder="Enter Prebid date"/>
      </xpath>
      <xpath expr="//field[@name='prebid_date']" position="after">
        <field name="prebid_location" placeholder="Enter Prebid location"/>
      </xpath>
    </field>
  </record>
</odoo>