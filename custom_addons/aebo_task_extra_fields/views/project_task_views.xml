<odoo>
    <record id="view_task_form_inherit_extra_fields" model="ir.ui.view">
        <field name="name">project.task.form.extra.fields</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="order_number"
                       placeholder="e.g. SO-00123"
                       groups="aebo_task_extra_fields.group_task_sensitive_fields"/>
                <field name="client_details"
                       placeholder="Write client details..."
                       groups="aebo_task_extra_fields.group_task_sensitive_fields"/>
                <field name="serial_number"
                       placeholder="e.g. SN-ABC-12345"/>
                <field name="crac_generated"
                       placeholder="enter CRAC number"/>
            </xpath>
        </field>
    </record>
</odoo>