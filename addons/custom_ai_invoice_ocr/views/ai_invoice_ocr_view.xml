<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Tree View -->
  <record id="view_ai_invoice_ocr_tree" model="ir.ui.view">
    <field name="name">ai.invoice.ocr.tree</field>
    <field name="model">ai.invoice.ocr</field>
    <field name="arch" type="xml">
      <tree string="AI Invoice OCR">
        <field name="name"/>
        <field name="extracted_text"/>
      </tree>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_ai_invoice_ocr_form" model="ir.ui.view">
    <field name="name">ai.invoice.ocr.form</field>
    <field name="model">ai.invoice.ocr</field>
    <field name="arch" type="xml">
      <form string="AI Invoice OCR">
        <group>
          <field name="name"/>
          <field name="extracted_text"/>
        </group>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_ai_invoice_ocr" model="ir.actions.act_window">
    <field name="name">AI Invoice OCR</field>
    <field name="res_model">ai.invoice.ocr</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Menu Items -->
  <menuitem id="menu_ai_invoice_ocr_root" name="AI OCR" sequence="10"/>
  <menuitem id="menu_ai_invoice_ocr" name="Invoice OCR" parent="menu_ai_invoice_ocr_root" action="action_ai_invoice_ocr" sequence="1"/>
</odoo>